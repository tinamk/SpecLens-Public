{
  "realm": "speclens",
  "enabled": true,
  "displayName": "SpecLens Dev",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "speclens-web",
      "name": "SpecLens Web",
      "enabled": true,
      "publicClient": false,
      "secret": "speclens-web-secret",
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://localhost:3000/api/auth/callback*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@speclens.dev",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ]
    }
  ]
}
