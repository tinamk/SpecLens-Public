# Public domains routed through Caddy
APP_DOMAIN=speclens.tinamk.no
API_DOMAIN=api.speclens.tinamk.no
AUTH_DOMAIN=auth.speclens.tinamk.no
OBJECTS_DOMAIN=objects.speclens.tinamk.no
GITHUB_GATEWAY_DOMAIN=github.speclens.tinamk.no

# App URLs
APP_URL=https://speclens.tinamk.no
API_URL=https://api.speclens.tinamk.no
NEXT_PUBLIC_API_URL=https://api.speclens.tinamk.no
INTERNAL_API_URL=http://api:4000
RUNNER_URL=http://runner:4510

# App behavior
APP_STATE_BACKEND=prisma
APP_STATE_ENCRYPTION_KEY=replace-with-32-byte-secret
AI_PROVIDER_ORDER=openai,openai-codex
WORKSPACE_RETENTION_DAYS=30

# OpenAI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CODEX_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex
OPENAI_CODEX_BASE_URL=https://api.openai.com/v1
CODEX_OAUTH_DEVICE_CODE_URL=https://auth.openai.com/api/accounts/deviceauth/usercode
CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_SCOPES=
CODEX_OAUTH_AUDIENCE=

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-admin-password
KEYCLOAK_BOOTSTRAP_ADMIN_CLIENT_ID=speclens-seed-admin
KEYCLOAK_BOOTSTRAP_ADMIN_CLIENT_SECRET=replace-with-strong-bootstrap-admin-client-secret
KEYCLOAK_CLIENT_ID=speclens-web
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_BASE_URL=https://speclens.tinamk.no

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=speclens
DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@postgres:5432/speclens
KEYCLOAK_DB_USER=postgres
KEYCLOAK_DB_PASSWORD=replace-with-strong-postgres-password
KEYCLOAK_DB_NAME=keycloak

# Object storage
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_BUCKET=speclens-artifacts
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objects.speclens.tinamk.no
OBJECT_STORAGE_REGION=ams3
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=speclensminio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_SUCCESS_URL=https://speclens.tinamk.no/portal?billing=success
STRIPE_CANCEL_URL=https://speclens.tinamk.no/pricing?billing=cancelled

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=./speclens-ai.private-key.pem
GITHUB_GATEWAY_URL=https://github.speclens.tinamk.no
GITHUB_GATEWAY_REGISTRATION_TOKEN=replace-with-strong-github-gateway-token
GITHUB_ALLOWED_RETURN_ORIGINS=https://speclens.tinamk.no
GITHUB_GATEWAY_FORWARD_TIMEOUT_MS=5000
GITHUB_WEBHOOK_TARGET_TTL_SECONDS=300

# DNS note
# Before running the public HTTPS verification playbook, the A record for
# speclens.tinamk.no must point to the deployed droplet public IPv4 address.

# Queue / runner
PG_BOSS_SCHEMA=pgboss
API_MAX_CONCURRENT_ANALYSES=2
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_MAX_CONCURRENCY=2
RUNNER_HEALTH_PORT=4510
RUNNER_HOST_TEMP_ROOT=/opt/speclens/runtime/host-temp/runner
AI_WORKER_HEALTH_PORT=4520
AI_WORKER_HOST_TEMP_ROOT=/opt/speclens/runtime/host-temp/ai-worker
AI_WORKER_CODEX_BYPASS_SANDBOX=false
HOST_CODEX_HOME=/opt/speclens/codex
SANDBOX_IMAGE=speclens/analysis-runner:local
SANDBOX_NETWORK_MODE=bridge
SANDBOX_BROWSER_BOOT_TIMEOUT_MS=120000

# Security / audit / ops
CSRF_SECRET=replace-with-strong-csrf-secret
AUDIT_LOG_ENABLED=true
API_TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ALLOW_LIST=
METRICS_ENABLED=true
ADMIN_EMAILS=e2e-admin@example.com

# Production E2E (Playwright)
E2E_BASE_URL=https://speclens.tinamk.no
E2E_OWNER_USERNAME=e2e-owner@speclens.tinamk.no
E2E_OWNER_PASSWORD=owner-password
E2E_MEMBER_USERNAME=e2e-member@speclens.tinamk.no
E2E_MEMBER_PASSWORD=member-password
E2E_OUTSIDER_USERNAME=e2e-outsider@speclens.tinamk.no
E2E_OUTSIDER_PASSWORD=outsider-password
E2E_ADMIN_USERNAME=e2e-admin@speclens.tinamk.no
E2E_ADMIN_PASSWORD=admin-password
E2E_GITHUB_PUBLIC_URL=https://github.com/octocat/Hello-World.git
E2E_GITHUB_PRIVATE_REPO_URL=https://github.com/tinamk/tinamk.no
E2E_GITHUB_PRIVATE_REPO_FULL_NAME=tinamk/tinamk.no
E2E_GITHUB_INSTALLATION_ID=
E2E_EXPECT_ENTITLEMENT=pro
E2E_SKIP_ENTITLEMENT_CHECK=false
E2E_UPLOAD_ARCHIVE_PATH=

# Contact
COMMERCIAL_CONTACT_EMAIL=hello@tinamk.no
