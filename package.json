{
  "name": "speclens-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "speclens": "./tools/speclens-cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "labels:inventory": "node tools/ui-text-inventory.mjs",
    "labels:lint": "node tools/ui-label-scan.mjs src/App.tsx",
    "lint:labels": "node tools/ui-label-scan.mjs",
    "preview": "vite preview",
    "speclens": "node tools/speclens-cli.mjs",
    "speclens:init": "node tools/speclens-cli.mjs init",
    "speclens:lint": "node tools/speclens-cli.mjs lint",
    "speclens:extract": "node tools/speclens-cli.mjs extract",
    "speclens:scan": "node tools/speclens-cli.mjs scan",
    "speclens:test": "node tools/speclens-cli.mjs test",
    "speclens:report": "node tools/speclens-cli.mjs report --html",
    "speclens:report:open": "node tools/speclens-cli.mjs report --html --open",
    "speclens:analyze": "node tools/speclens-cli.mjs analyze",
    "speclens:analyze:all": "node tools/speclens-cli.mjs analyze:all",
    "speclens:analyze:defence": "node tools/speclens-cli.mjs analyze:defence",
    "speclens:analyze:monitoring": "node tools/speclens-cli.mjs analyze:monitoring",
    "speclens:analyze:quality": "node tools/speclens-cli.mjs analyze:quality",
    "speclens:analyze:metadata": "node tools/speclens-cli.mjs analyze:metadata",
    "speclens:discover": "node tools/speclens-cli.mjs discover",
    "speclens:spec-check": "node tools/speclens-cli.mjs spec-check",
    "speclens:consistency": "node tools/speclens-cli.mjs consistency",
    "speclens:spec-generate": "node tools/speclens-cli.mjs spec-generate",
    "speclens:visual": "node tools/speclens-cli.mjs visual",
    "speclens:visual-filter": "node tools/speclens-cli.mjs visual-filter",
    "speclens:chaos": "node tools/speclens-cli.mjs chaos",
    "speclens:results": "node tools/speclens-cli.mjs results",
    "speclens:results:serve": "node tools/speclens-cli.mjs results --serve",
    "speclens:interaction": "node tools/speclens-cli.mjs interaction",
    "speclens:interaction:defence": "node tools/speclens-cli.mjs interaction --section client-defence",
    "speclens:interaction:monitoring": "node tools/speclens-cli.mjs interaction --section client-monitoring",
    "speclens:interaction:quality": "node tools/speclens-cli.mjs interaction --section client-quality",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.38.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
