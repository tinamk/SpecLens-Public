{
  "name": "speclens",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "build": "npm run typecheck",
    "validate:local": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:web": "next dev apps/web --hostname 0.0.0.0 --port 3000",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:runner": "tsx watch apps/runner/src/index.ts",
    "web:start": "next start apps/web",
    "api:start": "tsx apps/api/src/server.ts",
    "runner:start": "tsx apps/runner/src/index.ts",
    "dev:compose": "sh -lc '(docker compose version >/dev/null 2>&1 && docker compose up --build) || docker-compose up --build'",
    "dev:compose:down": "sh -lc '(docker compose version >/dev/null 2>&1 && docker compose down --remove-orphans) || docker-compose down --remove-orphans'",
    "dev:compose:logs": "sh -lc '(docker compose version >/dev/null 2>&1 && docker compose logs -f) || docker-compose logs -f'",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "speclens:api": "tsx apps/api/src/server.ts",
    "speclens:runner": "tsx apps/runner/src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.7.0",
    "clsx": "^2.1.1",
    "fastify": "^5.3.2",
    "jose": "^6.1.0",
    "next": "^15.3.2",
    "pg-boss": "^10.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^6.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
