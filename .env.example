# ── SpecLens environment variables ───────────────────────────────────────────
# Copy this file to .env.local (recommended) or .env and fill in your values.
# Both are gitignored — never commit secrets.

# Anthropic API key (required for discover, consistency, visual commands)
ANTHROPIC_API_KEY=sk-ant-...

# Optional default source path for analyze/discover (supports sibling folders)
# SPECLENS_SOURCE_PATH is also supported as an alias.
SPECLENS_DISCOVER_PATH=../client-frontend

# Optional TagTwo local app URL for self-check bootstrap runs
SPECLENS_TAGTWO_URL=http://app.localtest.me/

# client-frontend credentials (used by speclens:visual and speclens:analyze)
client_USERNAME=admin
client_PASSWORD=yourpassword
