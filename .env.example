API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
RUNNER_URL=http://localhost:4500

# ── AI providers (ordered) ───────────────────────────────────────────────────
