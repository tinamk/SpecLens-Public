# ── Core app URLs ────────────────────────────────────────────────────────────
CADDY_HTTP_PORT=18080
WEB_PORT=13000
API_PORT=14000
KEYCLOAK_PORT=18081
POSTGRES_PORT=15433
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
RUNNER_PORT=14510
AI_WORKER_PORT=14520
HOST_IP=192.168.0.100
# For dual local access, keep the app localhost-first and use HOST_IP for LAN/Tailscale aliases.
APP_URL=http://localhost:18080
API_URL=http://localhost:18080
NEXT_PUBLIC_API_URL=http://localhost:18080
INTERNAL_API_URL=http://api:4000
RUNNER_URL=http://localhost:14510

# ── AI providers (ordered) ───────────────────────────────────────────────────
AI_PROVIDER_ORDER=openai,openai-codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CODEX_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex
OPENAI_CODEX_BASE_URL=https://api.openai.com/v1

# ── Codex OAuth / AI worker ──────────────────────────────────────────────────
CODEX_OAUTH_DEVICE_CODE_URL=https://auth.openai.com/api/accounts/deviceauth/usercode
CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_SCOPES=
CODEX_OAUTH_AUDIENCE=
CODEX_BIN=codex
PG_BOSS_AI_QUEUE_NAME=ai-agent-jobs
AI_WORKER_ID=
AI_WORKER_POLL_INTERVAL_MS=5000
AI_WORKER_MAX_CONCURRENCY=1
AI_WORKER_HEALTH_PORT=4520
AI_WORKER_CODEX_TIMEOUT_MS=1800000
AI_WORKER_CODEX_MAX_ATTEMPTS=3
AI_WORKER_CODEX_RETRY_DELAY_MS=10000
AI_WORKER_CODEX_USE_OUTPUT_SCHEMA=false
AI_WORKER_CODEX_BYPASS_SANDBOX=false
# Home/XDG-scoped local storage is used by default when these are unset.
# SPECLENS_STATE_ROOT=
# SPECLENS_CACHE_ROOT=
# SPECLENS_TEMP_ROOT=
# SPECLENS_OBJECT_STORAGE_ROOT=
# AI_WORKER_TEMP_ROOT=

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URL=http://localhost:18080/auth/realms/speclens
KEYCLOAK_INTERNAL_ISSUER_URL=http://keycloak:8080/realms/speclens
KEYCLOAK_CLIENT_ID=speclens-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=http://localhost:18080
KEYCLOAK_REDIRECT_URIS=http://localhost:18080/*,http://localhost:18080/api/auth/callback,http://localhost:18080/api/auth/callback*,http://192.168.0.100:18080/*,http://192.168.0.100:18080/api/auth/callback,http://192.168.0.100:18080/api/auth/callback*
KEYCLOAK_WEB_ORIGINS=http://localhost:18080,http://192.168.0.100:18080
API_AUTH_MODE=keycloak
ADMIN_EMAILS=admin@speclens.dev
# Seeded local users:
# owner@speclens.dev / owner-password
# member@speclens.dev / member-password
# outsider@speclens.dev / outsider-password
# admin@speclens.dev / admin-password

