# ── Database / Queue ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speclens
APP_STATE_BACKEND=file
PG_BOSS_SCHEMA=pgboss
API_MAX_CONCURRENT_ANALYSES=2

# ── Object storage (S3-compatible, including self-hosted MinIO) ─────────────
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=speclens-artifacts
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

# Optional compatibility aliases for existing deployments:
SPACES_REGION=
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# ── Runner / Sandbox ─────────────────────────────────────────────────────────
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_MAX_CONCURRENCY=2
RUNNER_HEALTH_PORT=4510
SANDBOX_IMAGE=speclens/analysis-runner:local
SANDBOX_NETWORK_MODE=bridge
SANDBOX_BROWSER_BOOT_TIMEOUT_MS=120000

