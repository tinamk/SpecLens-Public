# ── Database / Queue ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:15433/speclens
APP_STATE_BACKEND=prisma
PG_BOSS_SCHEMA=pgboss
API_MAX_CONCURRENT_ANALYSES=2
WORKSPACE_RETENTION_DAYS=30

# ── Object storage (S3-compatible, MinIO by default; override for external) ──
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_BUCKET=speclens-artifacts
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

# Optional parallel mirror storage (write-through replication)
OBJECT_STORAGE_MIRROR_PROVIDER=
OBJECT_STORAGE_MIRROR_BUCKET=
OBJECT_STORAGE_MIRROR_ENDPOINT=
OBJECT_STORAGE_MIRROR_PUBLIC_ENDPOINT=
OBJECT_STORAGE_MIRROR_REGION=
OBJECT_STORAGE_MIRROR_FORCE_PATH_STYLE=false
OBJECT_STORAGE_MIRROR_ACCESS_KEY_ID=
OBJECT_STORAGE_MIRROR_SECRET_ACCESS_KEY=
OBJECT_STORAGE_MIRROR_REQUIRED=false

# Optional compatibility aliases for existing deployments:
SPACES_REGION=
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# ── Runner / Sandbox ─────────────────────────────────────────────────────────
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_MAX_CONCURRENCY=2
RUNNER_HEALTH_PORT=4510
SANDBOX_IMAGE=speclens/analysis-runner:local
SANDBOX_NETWORK_MODE=bridge
SANDBOX_BROWSER_BOOT_TIMEOUT_MS=120000
SANDBOX_CPU_LIMIT=1.5
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TEMP_RETENTION_MS=86400000
# RUNNER_TEMP_ROOT=

# ── Security / Audit ────────────────────────────────────────────────────────
CSRF_SECRET=
AUDIT_LOG_ENABLED=true
API_TRUST_PROXY=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ALLOW_LIST=127.0.0.1,::1
METRICS_ENABLED=true
AUDIT_EXPORT_PATH=
AUDIT_EXPORT_SINCE=
AUDIT_EXPORT_WORKSPACE_ID=
AUDIT_EXPORT_USER_ID=

# ── Production E2E (Playwright) ─────────────────────────────────────────────
E2E_BASE_URL=
E2E_API_READY_URL=
E2E_OWNER_USERNAME=
E2E_OWNER_PASSWORD=
E2E_MEMBER_USERNAME=
E2E_MEMBER_PASSWORD=
E2E_OUTSIDER_USERNAME=
E2E_OUTSIDER_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_GITHUB_PUBLIC_URL=https://github.com/octocat/Hello-World.git
E2E_GITHUB_PRIVATE_REPO_URL=https://github.com/tinamk/tinamk.no
E2E_GITHUB_PRIVATE_REPO_FULL_NAME=tinamk/tinamk.no
E2E_GITHUB_INSTALLATION_ID=
# Public-host GitHub E2E uses the dedicated E2E owner account, creates a timestamped workspace,
# requests the real install URL from SpecLens, and simulates the callback instead of completing GitHub UI.
E2E_EXPECT_ENTITLEMENT=pro
E2E_SKIP_ENTITLEMENT_CHECK=false
E2E_UPLOAD_ARCHIVE_PATH=

